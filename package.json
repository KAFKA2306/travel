{
  "name": "wayweave-travel-knowledge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:agent-entrypoint": "node scripts/validate-agent-entrypoint.mjs",
    "build:hotel-availability": "node scripts/build-hotel-availability.mjs",
    "test:hotel-availability": "node --test tests/hotel-availability.test.mjs",
    "test:destinations": "node --test tests/destinations.test.mjs",
    "test:kyushu-recovery-discount": "node --test tests/kyushu-recovery-discount.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
